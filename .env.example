# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# 8+ characters; `serve` refuses the example value. The Funnel URL is public, so this is the real gate.
PASSCODE=change-me
# 32+ characters; `serve` refuses shorter. python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Only for plain-http testing on a LAN IP; leave true behind Tailscale (https)
COOKIE_SECURE=true
# Tailscale auth key (admin console → Settings → Keys); reusable not needed
TS_AUTHKEY=
# --advertise-tags=tag:party (the tag must exist in your tailnet policy; see docs/DEPLOY.md)
TS_EXTRA_ARGS=
