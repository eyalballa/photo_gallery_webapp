{
  "openapi": "3.1.0",
  "info": {
    "title": "Birthday Photo Wall",
    "version": "0.1.0"
  },
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Login",
        "operationId": "login_api_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public": {
      "get": {
        "summary": "Public Config",
        "operationId": "public_config_api_public_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "Config",
        "operationId": "config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WallConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/photos": {
      "get": {
        "summary": "Photos",
        "operationId": "photos_api_photos_get",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotosResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/effects": {
      "get": {
        "summary": "Effects",
        "operationId": "effects_api_effects_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectsSettings"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Set Effects",
        "operationId": "set_effects_api_effects_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EffectsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectsSettings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/effects/reroll": {
      "post": {
        "summary": "Reroll Effects",
        "operationId": "reroll_effects_api_effects_reroll_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RerollReport"
                }
              }
            }
          }
        }
      }
    },
    "/media/{photo_id}.jpg": {
      "get": {
        "summary": "Media",
        "operationId": "media_media__photo_id__jpg_get",
        "parameters": [
          {
            "name": "photo_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Photo Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EffectSetting": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "face",
              "photo"
            ],
            "title": "Kind"
          },
          "on": {
            "type": "boolean",
            "title": "On"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "on"
        ],
        "title": "EffectSetting"
      },
      "EffectsSettings": {
        "properties": {
          "effects": {
            "items": {
              "$ref": "#/components/schemas/EffectSetting"
            },
            "type": "array",
            "title": "Effects"
          },
          "honoree": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Honoree"
          }
        },
        "type": "object",
        "required": [
          "effects",
          "honoree"
        ],
        "title": "EffectsSettings",
        "description": "The effect switches in the settings drawer: config.yaml's weights with the drawer's changes on top."
      },
      "EffectsUpdate": {
        "properties": {
          "off": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Off"
          },
          "honoree": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Honoree"
          }
        },
        "type": "object",
        "required": [
          "off"
        ],
        "title": "EffectsUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "passcode": {
            "type": "string",
            "maxLength": 256,
            "title": "Passcode"
          }
        },
        "type": "object",
        "required": [
          "passcode"
        ],
        "title": "LoginRequest"
      },
      "PhotoOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "w": {
            "type": "integer",
            "title": "W"
          },
          "h": {
            "type": "integer",
            "title": "H"
          },
          "aged": {
            "type": "boolean",
            "title": "Aged"
          },
          "first_seen": {
            "type": "string",
            "format": "date-time",
            "title": "First Seen"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "w",
          "h",
          "aged",
          "first_seen",
          "version",
          "url"
        ],
        "title": "PhotoOut"
      },
      "PhotosResponse": {
        "properties": {
          "photos": {
            "items": {
              "$ref": "#/components/schemas/PhotoOut"
            },
            "type": "array",
            "title": "Photos"
          },
          "removed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Removed"
          },
          "server_time": {
            "type": "string",
            "format": "date-time",
            "title": "Server Time"
          }
        },
        "type": "object",
        "required": [
          "photos",
          "removed",
          "server_time"
        ],
        "title": "PhotosResponse"
      },
      "PublicConfig": {
        "properties": {
          "login_title": {
            "type": "string",
            "title": "Login Title"
          }
        },
        "type": "object",
        "required": [
          "login_title"
        ],
        "title": "PublicConfig",
        "description": "What the passcode screen may show to anyone with the URL."
      },
      "RerollReport": {
        "properties": {
          "queued": {
            "type": "integer",
            "title": "Queued"
          }
        },
        "type": "object",
        "required": [
          "queued"
        ],
        "title": "RerollReport"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WallConfig": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "qr_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Qr Url"
          },
          "theme": {
            "type": "string",
            "enum": [
              "kids",
              "grown",
              "roses"
            ],
            "title": "Theme"
          },
          "background": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Background"
          },
          "decorations": {
            "type": "boolean",
            "title": "Decorations"
          },
          "crossing_seconds": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 8.0,
            "title": "Crossing Seconds"
          },
          "new_marker": {
            "type": "boolean",
            "title": "New Marker"
          },
          "effect_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Effect Labels"
          }
        },
        "type": "object",
        "required": [
          "title",
          "qr_url",
          "theme",
          "background",
          "decorations",
          "crossing_seconds",
          "new_marker",
          "effect_labels"
        ],
        "title": "WallConfig"
      }
    }
  }
}